# --- Database (Supabase / PostgreSQL) ---
# Ссылка Transaction Pooler (порт 6543) - для работы приложения
# Пример: postgres://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=""

# Ссылка Session Pooler (порт 5432) - для миграций Prisma (Direct connection)
# Пример: postgres://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DIRECT_URL=""

# --- NextAuth.js (Аутентификация) ---
# Секретный ключ для шифрования сессий (сгенерировать: openssl rand -base64 32)
NEXTAUTH_SECRET="changeme_random_secure_string_base64_32chars"
# URL сайта (для продакшена: https://your-domain.com)
NEXTAUTH_URL="http://localhost:3000"

# --- Email (SMTP) ---
# Настройки для отправки писем (заказы, уведомления)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="your-smtp-password"
# Адрес отправителя (должен быть подтвержден в SMTP сервисе)
EMAIL_FROM="noreply@latvbelfruits.com"
# Email администратора для получения уведомлений о заказах
ADMIN_EMAIL="Latvbelfruits@mail.ru"

# --- Payments (Stripe) ---
# Опционально: Ключи для оплаты картами
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Analytics ---
# Опционально: ID счетчиков
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_YM_ID=""

# --- Social Login (Optional) ---
# Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- AI & External APIs (Optional) ---
# OpenRouter (для генерации рецептов)
OPENROUTER_API_KEY=""
# Spoonacular (для поиска рецептов)
SPOONACULAR_API_KEY=""

# --- CMS (Optional) ---
# Если используется внешняя CMS (Strapi и т.д.)
NEXT_PUBLIC_CMS_URL="http://localhost:1337"
