{
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "excerpt": { "type": "text" },
    "date": { "type": "date" },
    "cover": { "type": "media", "multiple": false },
    "tags": { "type": "json" },
    "content": { "type": "richtext" }
  }
}


